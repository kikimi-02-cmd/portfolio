# /automation ランディングページの設定。
# Vercel → Settings → Environment Variables に入れる (Production / Preview 両方)。
# 保存後は再デプロイが必要。手順は docs/automation-ads-plan.md §6。

# 問い合わせフォームの送信先 (Formspree)
NEXT_PUBLIC_FORM_ENDPOINT=

# 本番ドメイン。末尾スラッシュなし。例) https://example.com
# フォーム送信後の遷移先 (/automation/thanks) の組み立てに使う
NEXT_PUBLIC_SITE_URL=

# Google 広告のタグ ID。例) AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=

# コンバージョンラベル (送信先の "/" 以降)。例) AbC-D_efGhIjKlMnO
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
